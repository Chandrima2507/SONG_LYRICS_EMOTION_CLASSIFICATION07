# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# MongoDB Connection String (Atlas or Local)
# If left empty or invalid, the backend will automatically use its in-memory store
MONGODB_URI=mongodb://127.0.0.1:27017/emolyrics

# JWT Authentication Secret
JWT_SECRET=emolyrics-super-secure-production-secret-key-2026
